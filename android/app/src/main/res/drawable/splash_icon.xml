<?xml version="1.0" encoding="utf-8"?>
<!-- The icon of the system start-up screen (Android 12 and up, and the backport before it): the JellyBytes logo, sized to the 288dp canvas it expects. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:width="288dp" android:height="288dp" android:gravity="center">
        <bitmap android:src="@drawable/splash_logo" android:gravity="fill" />
    </item>
</layer-list>
