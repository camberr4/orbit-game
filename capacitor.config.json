{
  "appId": "com.jellybytes.halorun",
  "appName": "Halo Run",
  "webDir": "www",
  "backgroundColor": "#04091c",
  "android": {
    "allowMixedContent": false,
    "backgroundColor": "#04091c"
  },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": false,
      "backgroundColor": "#04091c",
      "showSpinner": false,
      "androidScaleType": "CENTER_CROP",
      "splashFullScreen": true,
      "splashImmersive": true
    },
    "LocalNotifications": {
      "smallIcon": "ic_stat_halo",
      "iconColor": "#4DF3FF"
    }
  }
}
